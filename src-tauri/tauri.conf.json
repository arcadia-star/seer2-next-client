{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "seer2-next-client-tauri",
    "version": "1.1.4",
    "identifier": "xyz.seer2.nextclient.tauri",
    "build": {
        "beforeDevCommand": "pnpm run tauri:frontend:dev",
        "devUrl": "http://127.0.0.1:1420",
        "beforeBuildCommand": "pnpm run tauri:frontend:build",
        "frontendDist": "../dist-tauri"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "seer2-next-client-tauri",
                "width": 1200,
                "height": 660,
                "minWidth": 960,
                "minHeight": 540,
                "resizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "../runtime/icons/256x256.png",
            "../build/icon.ico"
        ],
        "resources": {
            "../runtime": "runtime"
        }
    }
}
