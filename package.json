{
  "name": "seer2-next-client",
  "version": "1.1.4",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "tauri:frontend:dev": "vite --config vite.tauri.config.ts --host 127.0.0.1 --port 1420 --strictPort",
    "tauri:frontend:build": "vite build --config vite.tauri.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "fmt": "prettier --write src/",
    "prebuild": "electron-vite build",
    "build": "pnpm run prebuild && electron-builder --config electron-builder.config.ts",
    "release": "pnpm run prebuild && electron-builder --config electron-builder.config.ts --publish always"
  },
  "author": "ukuq",
  "license": "MIT",
  "description": "seer2",
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/electron-json-storage": "^4.5.4",
    "@types/koa": "^3.0.0",
    "@types/node-fetch": "^2.6.13",
    "electron": "^11.5.0",
    "electron-builder": "^26.0.12",
    "electron-json-storage": "^4.6.0",
    "electron-vite": "^4.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "^0.3.0",
    "koa": "^2.16.2",
    "node-fetch": "^2.7.0"
  }
}
