{
  "name": "seer2-next-client",
  "version": "1.0.8",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "compile": "electron-webpack",
    "build": "npm run compile && electron-builder",
    "release": "npm run compile && electron-builder --publish always"
  },
  "author": "ukuq",
  "license": "MIT",
  "description": "seer2",
  "devDependencies": {
    "electron": "^11.5.0",
    "electron-builder": "^24.13.3",
    "electron-webpack": "^2.8.2",
    "xml2json": "^0.12.0"
  },
  "dependencies": {
    "about-window": "^1.15.2",
    "electron-json-storage": "^4.6.0",
    "electron-updater": "^6.1.8",
    "node-fetch": "^2.7.0",
    "source-map-support": "^0.5.21"
  },
  "electronWebpack": {
    "commonSourceDirectory": "common",
    "main": {
      "sourceDirectory": "src/main/"
    },
    "renderer": {
      "sourceDirectory": null
    }
  },
  "build": {
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "dist/main/main.js"
    ],
    "extraResources": [
      "runtime/common"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        "runtime/win"
      ]
    },
    "mac": {
      "target": "dmg",
      "extraResources": [
        "runtime/mac"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "arcadia-star",
        "repo": "seer2-next-client-release"
      }
    ]
  }
}
